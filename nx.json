{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": false,
      "projectsAffectedByDependencyUpdates": "auto"
    }
  },
  "release": {
    "projects": ["packages/*"],
    "projectsRelationship": "independent",
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    },
    "conventionalCommits": {
      "types": {
        "refactor": {
          "semverBump": "none",
          "changelog": {
            "hidden": false
          }
        },
        "docs": {
          "semverBump": "none",
          "changelog": {
            "hidden": false
          }
        },
        "build": {
          "semverBump": "none",
          "changelog": {
            "hidden": false
          }
        },
        "types": {
          "semverBump": "none",
          "changelog": {
            "hidden": false
          }
        },
        "chore": {
          "semverBump": "none",
          "changelog": {
            "hidden": false
          }
        },
        "examples": {
          "semverBump": "none",
          "changelog": {
            "hidden": false
          }
        },
        "test": {
          "semverBump": "none",
          "changelog": {
            "hidden": false
          }
        },
        "style": {
          "semverBump": "none",
          "changelog": {
            "hidden": false
          }
        },
        "ci": {
          "semverBump": "none",
          "changelog": {
            "hidden": false
          }
        },
        "revert": {
          "semverBump": "none",
          "changelog": {
            "hidden": false
          }
        }
      }
    },
    "version": {
      "conventionalCommits": true,
      "fallbackCurrentVersionResolver": "disk"
    },
    "changelog": {
      "automaticFromRef": true,
      "workspaceChangelog": false,
      "projectChangelogs": {
        "createRelease": "github",
        "entryWhenNoChanges": "This was a dependency update only for {projectName}, there were no code changes.",
        "renderOptions": {
          "authors": false
        }
      }
    },
    "git": {
      "commit": true,
      "tag": true,
      "commitMessage": "chore(release): publish [skip ci]"
    }
  }
}
